# Example environment file for POPPFIRE Starlink sync jobs
# Copy to: /etc/poppfire/starlink_sync.env
# Permissions: chmod 600 /etc/poppfire/starlink_sync.env

# Django Starlink API
API_URL="https://sreadmin.poppnet.com.br/api/starlink"
API_TOKEN="REPLACE_ME"

# FreeRADIUS client secret to use for generated clients
RADIUS_SECRET="REPLACE_ME"

# FreeRADIUS output file
RADIUS_OUTPUT_FILE="/etc/freeradius/clients_starlink.conf"

# Filter prefixes by IP version (4 | 6 | both)
IP_VERSION="both"

# Optional: include custom prefixes configured in Django Admin
INCLUDE_CUSTOM="1"

# Optional: include non-americas (set to 1 to disable americas-only filter)
INCLUDE_NON_AMERICAS="0"

# BlastRADIUS mitigations for legacy NAS
# unset | true | false
REQUIRE_MESSAGE_AUTHENTICATOR="unset"
LIMIT_PROXY_STATE="unset"
